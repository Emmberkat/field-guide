{
  "name": "field-guide",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:links": "lychee --root-dir \"$PWD/dist\" \"src/content/docs/**/*.md\" \"src/content/docs/**/*.mdx\" dist",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/starlight": "^0.42.5",
    "@system76/satteri-relative-markdown-links": "^1.1.1",
    "astro": "^7.2.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
